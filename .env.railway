# Copy nilai-nilai ini ke Railway Environment Variables
# Settings > Environment > Add Variable

APP_NAME="E-Perpustakaan"
APP_ENV=production
APP_KEY=  # Generate dengan: php artisan key:generate --show
APP_DEBUG=false
APP_URL=  # Isi dengan URL Railway setelah deploy

APP_LOCALE=id
APP_FALLBACK_LOCALE=id

LOG_CHANNEL=stderr
LOG_LEVEL=error

# Database - isi dari Railway MySQL service
DB_CONNECTION=mysql
DB_HOST=  # Dari Railway MySQL
DB_PORT=3306
DB_DATABASE=  # Dari Railway MySQL
DB_USERNAME=  # Dari Railway MySQL
DB_PASSWORD=  # Dari Railway MySQL

SESSION_DRIVER=file
SESSION_LIFETIME=480

CACHE_STORE=file
QUEUE_CONNECTION=sync

FILESYSTEM_DISK=local
